{
  "name": "reveng",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test:logic": "rm -rf .tmp-logic-tests && tsc -p tsconfig.logic-tests.json && node --require ./tests/helpers/register-compiled-aliases.cjs --test .tmp-logic-tests/tests/logic/*.test.js",
    "smoke:automation": "bash scripts/automation-smoke.sh",
    "deploy": "node scripts/production-release.mjs",
    "test:partner-handoff-db": "node tests/database/partner-sales-handoff.mjs",
    "prebuild": "node scripts/check-release-contracts.mjs",
    "postbuild": "node scripts/check-release-contracts.mjs --built",
    "test:crm-remediation": "node --test tests/integration/crm-remediation.mjs tests/database/crm-financial-commands.mjs tests/database/crm-lifecycle-event-ledger.mjs tests/integration/inbound-lead-handling.mjs tests/database/inbound-call-handling.mjs",
    "test:browser:session": "node tests/browser/session-recovery.mjs",
    "test:relationship-next-step": "node --test tests/integration/relationship-next-step.mjs tests/database/relationship-next-step.mjs",
    "test:browser:next-step": "node tests/browser/relationship-next-step.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1148.0",
    "@aws-sdk/client-ses": "^3.1148.0",
    "@aws-sdk/client-sesv2": "^3.1130.0",
    "@aws-sdk/client-sns": "^3.1130.0",
    "@aws-sdk/client-support": "^3.1130.0",
    "@cloudflare/realtimekit": "^2.0.1",
    "@cloudflare/realtimekit-react": "^2.0.1",
    "@cloudflare/realtimekit-react-ui": "^2.0.1",
    "@sentry/nextjs": "^10.76.2",
    "@stripe/react-stripe-js": "^5.6.1",
    "@stripe/stripe-js": "^8.10.0",
    "@types/bcryptjs": "^3.0.0",
    "bcryptjs": "^3.0.3",
    "ffmpeg-static": "^5.3.0",
    "heic-convert": "^2.1.0",
    "lucide-react": "^0.436.0",
    "next": "^15.5.28",
    "postal-mime": "^2.7.6",
    "react": "^18",
    "react-dom": "^18",
    "stripe": "^20.4.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10",
    "playwright": "^1.64.1",
    "postcss": "8.5.23",
    "tailwindcss": "^3.4.0",
    "typescript": "^5"
  },
  "overrides": {
    "postcss": "8.5.23",
    "sharp": "0.35.5",
    "uuid": "11.1.1",
    "postcss-selector-parser": "7.1.6"
  }
}
