        "operations",
        "partnerships"
      ],
      "services": [
        "storage_transfer",
        "contents_move",
        "referral_coordination"
      ],
      "message_angle": "Determine whether the organization is a buyer, referral partner, supplier or competitor before choosing copy."
    },
