        "property manager",
        "leasing",
        "facilities",
        "broker"
      ],
      "services": [
        "resident_referral",
        "office_relocation",
        "furniture_transfer"
      ],
      "message_angle": "Build a useful relationship around tenant/client introductions and approved building moves; honor existing conversation context."
    },
